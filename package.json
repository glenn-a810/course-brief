{
  "name": "course-brief",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CourseBrief (코스브리프) — 전국 540개 골프장 상세 스펙·실전 브리핑·렌탈 가이드. 정적 웹(Cloudflare Pages) + 구장별 JSON 데이터",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p functions/tsconfig.json",
    "build": "npm run typecheck && node scripts/build-site.mjs",
    "preview": "node scripts/serve.mjs",
    "verify": "node scripts/verify.mjs",
    "check": "npm run build && npm run verify",
    "data:build": "python3 scripts/build_data_split.py --src data/source/golf_courses_all_v29.json",
    "data:check": "python3 scripts/build_data_split.py --src data/source/golf_courses_all_v29.json --check",
    "es:up": "docker compose -f elasticsearch/docker-compose.yml up -d",
    "es:down": "docker compose -f elasticsearch/docker-compose.yml down",
    "es:bulk": "node elasticsearch/ingest.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "license": "SEE LICENSE IN README.md"
}
